# ============================================================
# 复制成 .env 再改：  cp .env.example .env   （Windows: copy .env.example .env）
#
# .env 已经在 .gitignore 里，不会被提交。
# 这个文件只是模板，永远不要把真实凭据写进 .env.example。
# ============================================================

# 网关自己的密钥。客户端（dsh / OpenAI SDK / Cherry Studio…）用它访问 /v1。
# 留空即可 —— 首次启动会自动生成一个并写回 .env，之后重启不变。
GATEWAY_KEY=

# ------------------------------------------------------------
# 上游模式，三选一：
#   campus    自定义协议（有状态会话 + 自定义 event 名）
#             → 默认指向本地模拟服务 http://127.0.0.1:8100
#   ssejson   只有 data: 行、靠 type 字段区分事件；也可能整段返回 JSON
#             → 地址和 token 自己填
#   openai    标准 OpenAI 兼容
#             → Ollama / vLLM / DeepSeek / 任意厂商
# ------------------------------------------------------------
MODE=campus

# ------------------------------------------------------------
# ssejson 模式
# 只填「你自己有权访问」的上游。看 README 顶部的声明。
# ------------------------------------------------------------
SSEJSON_BASE_URL=https://your-own-upstream.example.com/api/chat
SSEJSON_TOKEN=
SSEJSON_MODEL=ssejson-agent-v1

# 这条上游通常没有工具调用通道，tools 只能靠提示词模拟：
#   emulate  把工具清单塞进 system prompt，模型吐约定的 JSON 就还原成 tool_calls（默认）
#   off      完全忽略客户端传来的 tools
SSEJSON_TOOLS=emulate

# ------------------------------------------------------------
# openai 模式（标准兼容上游，纯透传）
# 例：
#   UPSTREAM_BASE_URL=http://127.0.0.1:11434/v1      # Ollama
#   UPSTREAM_BASE_URL=https://api.deepseek.com/v1    # DeepSeek
# ------------------------------------------------------------
UPSTREAM_BASE_URL=
UPSTREAM_API_KEY=
UPSTREAM_MODEL=

# ------------------------------------------------------------
# 网络
# 上游要走系统代理时设成 1；默认 0，避免环境里游荡的 HTTP_PROXY
# 把请求悄悄改成代理格式（README「坑 6」有详细说明）。
# ------------------------------------------------------------
UPSTREAM_TRUST_ENV=0

# 端口
HOST=127.0.0.1
PORT=8200
MOCK_PORT=8100
